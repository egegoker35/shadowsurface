# === REQUIRED ===
# PostgreSQL URL. Keep connection_limit low: one pool per app instance (3 for two instances).
DATABASE_URL=postgresql://user:password@host:25060/defaultdb?sslmode=require&connection_limit=3&pool_timeout=20

# Redis (rate limiting + scan queue)
REDIS_URL=redis://localhost:6379

# JWT signing secret, 32+ characters. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Public URL, used in emails and links
APP_URL=https://shadowsurface.app

# === ADMIN CONSOLE (/admin-login) ===
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# === EMAIL (optional) ===
# Resend key. Delivery to customers requires EMAIL_FROM on a domain verified in Resend;
# with the shared onboarding@resend.dev sender only the account owner receives mail.
RESEND_API_KEY=re_...
EMAIL_FROM=ShadowSurface <noreply@yourdomain.com>
